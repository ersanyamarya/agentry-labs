{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": ".."
  },
  "files": {
    "includes": [
      "src/**",
      "packages/*/src/**",
      "packages/*/*.json",
      "*.json",
      "*.jsonc",
      "!**/dist",
      "!**/node_modules",
      // generated by TanStack Router on every dev/build run
      "!**/routeTree.gen.ts"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        // Sorting object keys changes key order in JSON output and in deepStrictEqual-style tests.
        "useSortedKeys": "off"
      }
    }
  },
  "linter": {
    "rules": {
      "complexity": {
        // Ceiling at today's highest score so new code cannot get worse; refactoring would risk behaviour.
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 123 }
        }
      },
      "style": {
        // The u flag changes how a pattern parses and matches; adding it to existing regexes can change behaviour.
        "useUnicodeRegex": "off",
        // Naming groups changes how every match result is read (match[1] to match.groups).
        "useNamedCaptureGroup": "off",
        // Nested ternaries are the idiom for conditional Ink/JSX rendering here.
        "noNestedTernary": "off"
      },
      "performance": {
        // Hoisting a regex with g or y shares lastIndex across calls; the CLI is not a hot path.
        "useTopLevelRegex": "off",
        // Awaits in loops are deliberately sequential (file edits, backups, prompts) and order matters.
        "noAwaitInLoops": "off"
      },
      "suspicious": {
        // "${VAR}" is the literal MCP env-expansion syntax the CLI reads and writes, not a broken template.
        "noTemplateCurlyInString": "off",
        // Removing async changes the return type (promise vs value) of injected dependencies.
        "useAwait": "off"
      }
    }
  },
  "overrides": [
    {
      // Small local screens: inline handlers are clearer than a useCallback per prop and cost nothing measurable here.
      "includes": ["packages/web/src/**"],
      "linter": { "rules": { "performance": { "noJsxPropsBind": "off" } } }
    },
    {
      // Generated by the shadcn CLI and kept as shipped, so `shadcn add --overwrite` diffs stay clean.
      "includes": ["packages/web/src/components/ui/**"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      // TanStack Router derives URLs from route file names: `$` is a splat segment (rpc.$.ts serves /rpc/*).
      "includes": ["packages/web/src/routes/**"],
      "linter": {
        "rules": { "style": { "useFilenamingConvention": "off" } }
      }
    },
    {
      "includes": ["packages/core/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "core has no UI",
                  "ink": "core has no UI",
                  "@agentry/tui": "core imports no UI",
                  "@agentry/web": "core imports no UI"
                },
                "patterns": [
                  {
                    "group": [
                      "react/*",
                      "react-dom",
                      "react-dom/*",
                      "ink-*",
                      "ink/*",
                      "@tanstack/*",
                      "@agentry/*",
                      "**/tui/src/**",
                      "**/web/src/**"
                    ],
                    "message": "core imports no UI or workspace package"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/tui/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@agentry/web": "tui and web never import each other"
                },
                "patterns": [
                  {
                    "group": [
                      "@agentry/web/*",
                      "@tanstack/*",
                      "**/web/src/**",
                      "**/core/src/**"
                    ],
                    "message": "tui imports core only"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/test/**", "packages/*/src/test/**"],
      "linter": {
        "rules": {
          "style": {
            // Tests assert a value was found, so a non-null assertion is the shortest correct form.
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            // Tests match terminal output, which contains control characters and escape codes.
            "noControlCharactersInRegex": "off",
            "noEmptyBlockStatements": "off"
          }
        }
      }
    }
  ]
}
