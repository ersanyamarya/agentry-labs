{
  "name": "@ersanyamarya/agentry-cli",
  "version": "0.1.0",
  "description": "agentry: inspect and manage what a Claude Code session loads (skills, MCP servers, hooks, plugins, CLAUDE.md), with a terminal UI",
  "keywords": [
    "claude-code",
    "claude",
    "cli",
    "mcp",
    "skills",
    "hooks",
    "plugins",
    "tui",
    "ink"
  ],
  "homepage": "https://github.com/ersanyamarya/agentry-labs/tree/main/cli#readme",
  "bugs": {
    "url": "https://github.com/ersanyamarya/agentry-labs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ersanyamarya/agentry-labs.git",
    "directory": "cli"
  },
  "license": "MIT",
  "author": "Sanyam Arya",
  "type": "module",
  "bin": {
    "agentry": "dist/bin/agentry.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "biome check .",
    "dev": "tsc --watch",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "prepublishOnly": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && npm run build && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "figures": "^6.1.0",
    "ink": "^8.0.0",
    "ink-spinner": "^5.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2",
    "ultracite": "^8.1.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
