#!/usr/bin/env bash
# Shared helpers for scripts/run_all.sh and scripts/build_release.sh:
# device discovery plus build/install/launch primitives for Android (adb),
# iOS (flutter run / devicectl) and macOS. Generated by the
# flutter-device-scripts-setup skill; app identifiers below were read from
# the project. Edit them here if the project changes.
#
# Bash 3.2 (macOS default) note: keep every variable next to non-ASCII text
# braced (${var}) and keep this file ASCII-only.

set -euo pipefail

# --- Project identifiers (detected) ---------------------------------------
ANDROID_APP_ID="{{ANDROID_APP_ID}}"
ANDROID_DEBUG_APP_ID="{{ANDROID_DEBUG_APP_ID}}"
ANDROID_LAUNCH_ACTIVITY="{{ANDROID_LAUNCH_ACTIVITY}}"
IOS_BUNDLE_ID="{{IOS_BUNDLE_ID}}"
MACOS_APP_NAME="{{MACOS_APP_NAME}}"
ANDROID_ENABLED={{ANDROID_ENABLED}}
IOS_ENABLED={{IOS_ENABLED}}
MACOS_ENABLED={{MACOS_ENABLED}}

log() { printf '\033[1;34m[dev]\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31m[dev]\033[0m %s\n' "$*" >&2; exit 1; }

# --- Android ----------------------------------------------------------------
APK_PATH="build/app/outputs/flutter-apk/app-debug.apk"
RELEASE_APK_PATH="build/app/outputs/flutter-apk/app-release.apk"

# One adb serial per line for devices in "device" state (skips unauthorized/offline).
android_serials() {
  [[ "$ANDROID_ENABLED" == true ]] && command -v adb >/dev/null 2>&1 || return 0
  adb devices | awk 'NR>1 && $2=="device" {print $1}'
}

# Explicit `flutter build`, not `flutter install`, which can silently reuse a stale APK.
android_build() { log "Building debug APK..."; flutter build apk --debug; }
android_build_release() { log "Building release APK..."; flutter build apk --release; }

android_install() {
  local serial="$1" apk_path="${2:-$APK_PATH}"
  log "Installing ${apk_path##*/} on Android device ${serial}..."
  adb -s "$serial" install -r "$apk_path" >/dev/null
}
android_install_release() { android_install "$1" "$RELEASE_APK_PATH"; }

# [app_id] defaults to the debug id (it may carry a suffix such as ".debug").
android_launch() {
  local serial="$1" app_id="${2:-$ANDROID_DEBUG_APP_ID}"
  adb -s "$serial" shell am start -n "${app_id}/${ANDROID_LAUNCH_ACTIVITY}" >/dev/null
}
android_launch_release() { android_launch "$1" "$ANDROID_APP_ID"; }

# --- iOS ----------------------------------------------------------------------
IOS_RUN_DIR="scripts/.run"
IOS_APP_PATH="build/ios/iphoneos/Runner.app"

# One UDID per line for physical, connected iPhones. devicectl JSON is its only stable interface.
ios_udids() {
  [[ "$IOS_ENABLED" == true ]] && command -v xcrun >/dev/null 2>&1 || return 0
  xcrun devicectl list devices --json-output - 2>/dev/null | python3 -c '
import json, sys
devices = json.load(sys.stdin).get("result", {}).get("devices", [])
for d in devices:
    hw = d.get("hardwareProperties", {})
    conn = d.get("connectionProperties", {})
    if hw.get("deviceType") == "iPhone" and conn.get("tunnelState") == "connected":
        print(hw.get("udid"))
'
}

# A debug Flutter app cannot be launched on a physical iPhone by devicectl
# (it shows Flutter's placeholder screen); it needs the Dart VM service that
# `flutter run` attaches. So debug runs keep `flutter run` alive in the
# background and wait until it reports the app is up.
ios_run_background() {
  local udid="$1"
  mkdir -p "$IOS_RUN_DIR"
  local run_log="$IOS_RUN_DIR/${udid}.log" pid_file="$IOS_RUN_DIR/${udid}.pid"
  if [[ -f "$pid_file" ]] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
    log "flutter run already active for iOS device ${udid} (pid $(cat "$pid_file")); reusing it."
    return
  fi
  log "Building, installing and launching (flutter run) on iOS device ${udid}..."
  : >"$run_log"
  nohup flutter run -d "$udid" --debug >"$run_log" 2>&1 &
  echo $! >"$pid_file"
  local waited=0
  until grep -q "A Dart VM Service\|Flutter run key commands" "$run_log" 2>/dev/null; do
    kill -0 "$(cat "$pid_file")" 2>/dev/null || die "flutter run exited before starting; see ${run_log}"
    (( waited < 180 )) || die "Timed out waiting for flutter run on iOS device ${udid}; see ${run_log}"
    sleep 2
    waited=$((waited + 2))
  done
  log "iOS device ${udid} is running (log: ${run_log})."
}

# Release builds run standalone, so plain build + install + launch works.
ios_build_release() { log "Building release iOS app..."; flutter build ios --release; }
ios_install_release() {
  log "Installing release build on iOS device ${1}..."
  xcrun devicectl device install app --device "$1" "$IOS_APP_PATH" >/dev/null
}
ios_launch_release() { xcrun devicectl device process launch --device "$1" "$IOS_BUNDLE_ID" >/dev/null; }

# --- macOS --------------------------------------------------------------------
MACOS_DEBUG_APP="build/macos/Build/Products/Debug/${MACOS_APP_NAME}.app"
MACOS_RELEASE_APP="build/macos/Build/Products/Release/${MACOS_APP_NAME}.app"
MACOS_INSTALL_DIR="$HOME/Applications"

macos_available() { [[ "$MACOS_ENABLED" == true && "$(uname -s)" == "Darwin" ]]; }

macos_build() { log "Building debug macOS app..."; flutter build macos --debug; }
macos_build_release() { log "Building release macOS app..."; flutter build macos --release; }

# `open` on a running app only brings it forward, so quit first and wait.
macos_quit() {
  pkill -x "$MACOS_APP_NAME" 2>/dev/null || return 0
  local waited=0
  while pgrep -x "$MACOS_APP_NAME" >/dev/null && (( waited < 20 )); do
    sleep 0.5
    waited=$((waited + 1))
  done
}

# Launch with `open`, never `flutter run`: a child of `flutter run` gets its
# camera/mic permission checked against the parent terminal and is denied.
macos_launch() { macos_quit; open "${1:-$MACOS_DEBUG_APP}"; }

macos_install_release() {
  log "Installing release build to ${MACOS_INSTALL_DIR}/${MACOS_APP_NAME}.app..."
  macos_quit
  mkdir -p "$MACOS_INSTALL_DIR"
  rm -rf "${MACOS_INSTALL_DIR:?}/${MACOS_APP_NAME}.app"
  ditto "$MACOS_RELEASE_APP" "$MACOS_INSTALL_DIR/${MACOS_APP_NAME}.app"
}
macos_launch_release() { macos_launch "$MACOS_INSTALL_DIR/${MACOS_APP_NAME}.app"; }
