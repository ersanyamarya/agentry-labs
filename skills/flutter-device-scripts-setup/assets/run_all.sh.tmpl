#!/usr/bin/env bash
# Builds, installs and launches a debug build of {{APP_NAME}} on every
# connected Android phone, iPhone, and this Mac. Android goes through adb;
# iOS goes through `flutter run` kept alive in the background (see
# ios_run_background in lib.sh); macOS opens the debug .app.
#
# Usage: scripts/run_all.sh

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
source scripts/lib.sh

android=()
while IFS= read -r line; do [[ -n "$line" ]] && android+=("$line"); done < <(android_serials)
ios=()
while IFS= read -r line; do [[ -n "$line" ]] && ios+=("$line"); done < <(ios_udids)
macos=false
macos_available && macos=true

if [[ ${#android[@]} -eq 0 && ${#ios[@]} -eq 0 && "$macos" == false ]]; then
  die "No devices found (checked adb, xcrun devicectl, and this Mac)."
fi

[[ ${#android[@]} -gt 0 ]] && android_build

for serial in ${android[@]+"${android[@]}"}; do
  android_install "$serial"
  android_launch "$serial"
  log "Launched on Android device ${serial}"
done

for udid in ${ios[@]+"${ios[@]}"}; do
  ios_run_background "$udid"
done

if [[ "$macos" == true ]]; then
  macos_build
  macos_launch
  log "Launched on macOS"
fi
