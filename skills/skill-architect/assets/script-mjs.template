#!/usr/bin/env node
// [One line: what this script checks or produces.]
// Usage: node [script-name].mjs <input> [--limit N]
import fs from 'node:fs';
import { parseArgs } from 'node:util';

const { values, positionals } = parseArgs({
  allowPositionals: true,
  options: { limit: { type: 'string', default: '10' } },
});

if (positionals.length !== 1) {
  console.error('Usage: node [script-name].mjs <input> [--limit N]');
  process.exit(1);
}

const input = fs.readFileSync(positionals[0], 'utf8');
const limit = Number(values.limit);

// TODO: deterministic logic (parse, transform, exact checks).
const items = [];

// Print only what the model needs, capped so output stays small.
console.log(JSON.stringify({ total: items.length, top: items.slice(0, limit) }, null, 2));
