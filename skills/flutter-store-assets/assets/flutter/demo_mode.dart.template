import 'package:firebase_auth/firebase_auth.dart';
import 'package:hive_ce_flutter/hive_ce_flutter.dart';
import 'package:{{APP_PACKAGE}}/core/providers/app_entry_store.dart';
import 'package:{{APP_PACKAGE}}/data/local/local_store.dart';
import 'package:{{APP_PACKAGE}}/data/models/broker.dart';
import 'package:{{APP_PACKAGE}}/data/models/stored_message.dart';
import 'package:{{APP_PACKAGE}}/data/models/sync_state.dart';
import 'package:{{APP_PACKAGE}}/data/models/template.dart';
import 'package:{{APP_PACKAGE}}/data/models/user_profile.dart';
import 'package:{{APP_PACKAGE}}/data/models/workspace.dart';
import 'package:shared_preferences/shared_preferences.dart';

/// Build with `--dart-define=DEMO=true` to start on made-up data instead of the
/// device's own. Used only by the store-screenshot capture
/// (`pnpm nx run image-gen-tools:capture`), so the shots never show a
/// real broker, host or teammate.
///
/// **It wipes this install's local data**, which is why it is a compile-time
/// flag and not a setting: run it on a simulator, never on a device you use.
const bool kDemoMode = bool.fromEnvironment('DEMO');

const String demoUserId = 'demo-user';

/// Ids the capture test navigates to.
const String demoHomeWorkspaceId = 'demo-home';
const String demoTeamWorkspaceId = 'demo-team';
const String demoGreenhouseBrokerId = 'demo-greenhouse';
const String demoPhoneTemplateId = 'demo-tpl-phone';

// Public test brokers, one host each since a public host resets a client that
// opens several connections at once. The demo brokers really connect, so "Connected" and the
// live stream are genuine. Nothing private is ever sent to them.
const String _publicBroker = 'test.mosquitto.org';
const String _publicBrokerAlt = 'broker.hivemq.com';
const String _publicBrokerThird = 'broker.emqx.io';

/// Replaces local data with the demo set and enters the app as a guest.
///
/// Called after [AppEntryStore.loadFrom] and before the first auth read, so the
/// router sees a signed-out guest who has finished onboarding.
Future<void> prepareDemoMode(SharedPreferencesWithCache prefs) async {
  // A session left over on the simulator would hydrate real data over the seed.
  await FirebaseAuth.instance.signOut();
  AppEntryStore.instance
    ..markOnboardingSeen(prefs)
    ..chooseGuest(prefs);

  await Future.wait([
    Hive.box<Broker>(brokersBoxName).clear(),
    Hive.box<Workspace>(workspacesBoxName).clear(),
    Hive.box<Template>(templatesBoxName).clear(),
    Hive.box<UserProfile>(userProfileBoxName).clear(),
    Hive.box<StoredMessage>(messageLogBoxName).clear(),
  ]);

  final now = DateTime.now();
  final created = now.subtract(const Duration(days: 30));

  BrokerTopic topic(String name, String color, {int qos = 0}) =>
      BrokerTopic(name: name, color: color, qos: qos);

  Broker broker({
    required String id,
    required String workspaceId,
    required String name,
    required String icon,
    required String host,
    required List<BrokerTopic> topics,
    int port = 1883,
    bool isSecured = false,
    BrokerAuth? auth,
  }) => Broker(
    id: id,
    workspaceId: workspaceId,
    name: name,
    icon: icon,
    host: host,
    port: port,
    isSecured: isSecured,
    clientId: 'demo_${id.hashCode.toRadixString(16)}',
    auth: auth,
    topics: topics,
    createdAt: created,
    updatedAt: created,
    syncState: SyncState.synced,
  );

  final brokers = [
    broker(
      id: demoGreenhouseBrokerId,
      workspaceId: demoHomeWorkspaceId,
      name: 'Greenhouse',
      icon: 'thermostat',
      host: _publicBroker,
      topics: [
        topic('greenhouse/temperature', '#F4BE48'),
        topic('greenhouse/humidity', '#38BDF8', qos: 1),
        topic('greenhouse/lights/set', '#00A37A', qos: 1),
      ],
    ),
    broker(
      id: 'demo-workshop',
      workspaceId: demoHomeWorkspaceId,
      name: 'Workshop',
      icon: 'build',
      host: _publicBrokerAlt,
      topics: [
        topic('workshop/saw/state', '#FF5D2D'),
        topic('workshop/air/pressure', '#14B8A6'),
      ],
    ),
    broker(
      id: 'demo-garage',
      workspaceId: demoHomeWorkspaceId,
      name: 'Garage door',
      icon: 'garage',
      host: _publicBrokerThird,
      topics: [topic('garage/door/state', '#A9D473')],
    ),
    broker(
      id: 'demo-factory',
      workspaceId: demoTeamWorkspaceId,
      name: 'Line 2 telemetry',
      icon: 'analytics',
      host: 'mqtt.line2.example.com',
      port: 8883,
      isSecured: true,
      auth: const BrokerAuth(username: 'ops', password: 'demo'),
      topics: [topic('line2/+/status', '#353D69', qos: 1)],
    ),
  ];

  const members = [
    WorkspaceMember(
      userId: demoUserId,
      role: Role.admin,
      name: 'Sanyam Arya',
      email: 's.arya@example.com',
    ),
    WorkspaceMember(
      userId: 'demo-lena',
      role: Role.editor,
      name: 'Lena Hoffmann',
      email: 'l.hoffmann@example.com',
    ),
    WorkspaceMember(
      userId: 'demo-arjun',
      role: Role.editor,
      name: 'Arjun Mehta',
      email: 'a.mehta@example.com',
    ),
    WorkspaceMember(
      userId: 'demo-matthias',
      role: Role.peer,
      name: 'Matthias Schröder',
      email: 'm.schroeder@example.com',
    ),
    WorkspaceMember(
      userId: 'demo-ananya',
      role: Role.peer,
      name: 'Ananya Iyer',
      email: 'a.iyer@example.com',
    ),
    WorkspaceMember(
      userId: 'demo-katharina',
      role: Role.peer,
      name: 'Katharina Weber',
      email: 'k.weber@example.com',
    ),
  ];

  Workspace workspace(
    String id,
    String name,
    String color, {
    List<WorkspaceMember> members = const [],
  }) => Workspace(
    id: id,
    name: name,
    colorTag: color,
    members: members,
    createdAt: created,
    updatedAt: created,
    syncState: SyncState.synced,
  );

  Template template(
    String id,
    String name,
    String icon,
    String payload,
    List<SensorType> sensors,
  ) => Template(
    id: id,
    name: name,
    authorId: demoUserId,
    workspaceId: demoHomeWorkspaceId,
    payloadString: payload,
    sensorsUsed: sensors,
    icon: icon,
    createdAt: created,
    updatedAt: created,
    syncState: SyncState.synced,
  );

  final templates = [
    template(
      demoPhoneTemplateId,
      'Phone location',
      'location',
      '{\n  "lat": {{GPS_LAT}},\n  "lng": {{GPS_LNG}},\n  "alt": {{GPS_ALT}},\n  "at": "{{TIMESTAMP}}"\n}',
      [SensorType.gps, SensorType.time],
    ),
    template(
      'demo-tpl-motion',
      'Door sensor ping',
      'sensors',
      '{\n  "x": {{ACCEL_X}},\n  "y": {{ACCEL_Y}},\n  "z": {{ACCEL_Z}}\n}',
      [SensorType.accelerometer],
    ),
    template(
      'demo-tpl-battery',
      'Battery report',
      'battery',
      '{ "level": {{BATTERY_LVL}}, "state": "{{BATTERY_STATE}}" }',
      [SensorType.battery],
    ),
  ];

  StoredMessage message(
    int secondsAgo,
    String topic,
    String payload, {
    bool outbound = false,
    int qos = 0,
  }) => StoredMessage(
    id: 'demo-msg-${secondsAgo}_$topic',
    brokerId: demoGreenhouseBrokerId,
    topic: topic,
    payload: payload,
    qos: qos,
    retained: false,
    outbound: outbound,
    timestamp: now.subtract(Duration(seconds: secondsAgo)),
  );

  final messages = [
    message(170, 'greenhouse/temperature', '{"celsius": 21.4}'),
    message(150, 'greenhouse/humidity', '{"percent": 63}', qos: 1),
    message(118, 'greenhouse/temperature', '{"celsius": 21.6}'),
    message(96, 'greenhouse/lights/set', 'on', outbound: true, qos: 1),
    message(
      95,
      'greenhouse/lights/set',
      '{"state": "on", "by": "greenhouse-controller"}',
      qos: 1,
    ),
    message(64, 'greenhouse/humidity', '{"percent": 61}', qos: 1),
    message(41, 'greenhouse/temperature', '{"celsius": 22.1}'),
    message(18, 'greenhouse/humidity', '{"percent": 60}', qos: 1),
  ];

  await Hive.box<Broker>(
    brokersBoxName,
  ).putAll({for (final b in brokers) b.id: b});
  await Hive.box<Workspace>(workspacesBoxName).putAll({
    demoHomeWorkspaceId: workspace(demoHomeWorkspaceId, 'Home Lab', '#00A37A'),
    demoTeamWorkspaceId: workspace(
      demoTeamWorkspaceId,
      'Plant Team',
      '#353D69',
      members: members,
    ),
  });
  await Hive.box<Template>(
    templatesBoxName,
  ).putAll({for (final t in templates) t.id: t});
  await Hive.box<StoredMessage>(
    messageLogBoxName,
  ).putAll({for (final m in messages) m.id: m});
  await Hive.box<UserProfile>(userProfileBoxName).put(
    userProfileKey,
    UserProfile(
      id: demoUserId,
      name: 'Sanyam Arya',
      planTier: PlanTier.pro,
      recentBrokerIds: const [
        demoGreenhouseBrokerId,
        'demo-workshop',
        'demo-garage',
      ],
      syncedAt: now,
    ),
  );
}
