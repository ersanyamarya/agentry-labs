{
	"enabledPlugins": {
		"context-mode@context-mode": true
	},
	"env": {
		"TRAIL_INVOKED_AS": "trail"
	},
	"extraKnownMarketplaces": {
		"context-mode": {
			"source": {
				"repo": "mksglu/context-mode",
				"source": "github"
			}
		}
	},
	"hooks": {
		"PostToolUse": [
			{
				"hooks": [
					{
						"command": "node \"${HOME}/.claude/helpers/trail-hooks.cjs\" post-edit || exit 0",
						"timeout": 10,
						"type": "command"
					}
				],
				"matcher": "Write|Edit|MultiEdit"
			},
			{
				"hooks": [
					{
						"command": "node \"${HOME}/.claude/helpers/trail-hooks.cjs\" tool-savings || exit 0",
						"timeout": 8,
						"type": "command"
					}
				],
				"matcher": "Bash|mcp__trail__|Read|Grep|Glob|Skill"
			}
		],
		"PostToolUseFailure": [
			{
				"hooks": [
					{
						"command": "node \"${HOME}/.claude/helpers/trail-hooks.cjs\" post-bash-fail || exit 0",
						"timeout": 5,
						"type": "command"
					}
				],
				"matcher": "Bash"
			}
		],
		"PreToolUse": [
			{
				"hooks": [
					{
						"command": "node \"${HOME}/.claude/helpers/trail-hooks.cjs\" pre-edit || exit 0",
						"timeout": 5,
						"type": "command"
					}
				],
				"matcher": "Write|Edit|MultiEdit"
			},
			{
				"hooks": [
					{
						"command": "node \"${HOME}/.claude/helpers/trail-hooks.cjs\" pre-bash || exit 0",
						"timeout": 5,
						"type": "command"
					}
				],
				"matcher": "Bash"
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"command": "node \"${HOME}/.claude/helpers/trail-hooks.cjs\" session-end || exit 0",
						"timeout": 5,
						"type": "command"
					}
				]
			}
		],
		"SessionStart": [
			{
				"hooks": [
					{
						"command": "node \"${HOME}/.claude/helpers/trail-hooks.cjs\" session-start || exit 0",
						"timeout": 10,
						"type": "command"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"command": "node \"${HOME}/.claude/helpers/trail-hooks.cjs\" stop || exit 0",
						"timeout": 10,
						"type": "command"
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"command": "node \"${HOME}/.claude/helpers/trail-hooks.cjs\" prompt || exit 0",
						"timeout": 15,
						"type": "command"
					}
				]
			}
		]
	},
	"statusLine": {
		"command": "node \"${HOME}/.claude/helpers/trail-statusline.cjs\"",
		"type": "command"
	},
	"subagentStatusLine": {
		"command": "node \"${HOME}/.claude/helpers/trail-statusline.cjs\"",
		"type": "command"
	}
}
