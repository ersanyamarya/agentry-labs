{
	"enabledPlugins": {
		"context-mode@context-mode": true
	},
	"extraKnownMarketplaces": {
		"context-mode": {
			"source": {
				"repo": "mksglu/context-mode",
				"source": "github"
			}
		}
	},
	"hooks": {
		"PostToolUse": [
			{
				"hooks": [
					{
						"command": "node \"${HOME}/.claude/helpers/graft-hooks.cjs\" post-edit",
						"timeout": 10000,
						"type": "command"
					}
				],
				"matcher": "Write|Edit|MultiEdit"
			},
			{
				"hooks": [
					{
						"command": "node \"${HOME}/.claude/helpers/graft-hooks.cjs\" tool-savings",
						"timeout": 8000,
						"type": "command"
					}
				],
				"matcher": "Bash|mcp__graft__|Read|Grep|Glob"
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"command": "node \"${HOME}/.claude/helpers/graft-hooks.cjs\" session-end",
						"timeout": 8000,
						"type": "command"
					}
				]
			}
		],
		"SessionStart": [
			{
				"hooks": [
					{
						"command": "node \"${HOME}/.claude/helpers/graft-hooks.cjs\" session-start",
						"timeout": 8000,
						"type": "command"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"command": "node \"${HOME}/.claude/helpers/graft-hooks.cjs\" stop",
						"timeout": 8000,
						"type": "command"
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"command": "node \"${HOME}/.claude/helpers/graft-hooks.cjs\" prompt",
						"timeout": 15000,
						"type": "command"
					}
				]
			}
		]
	},
	"statusLine": {
		"command": "node \"${HOME}/.claude/helpers/graft-statusline.cjs\"",
		"type": "command"
	},
	"subagentStatusLine": {
		"command": "node \"${HOME}/.claude/helpers/graft-statusline.cjs\"",
		"type": "command"
	}
}
